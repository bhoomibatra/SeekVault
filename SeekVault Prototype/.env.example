# SeekVault Environment Configuration Template
# Copy this file to .env to customize your local installation if needed.
# Real .env files are excluded from Git version control by default.

# Optional: Path to custom Python executable if not in virtualenv or system PATH
# SEEKVAULT_PYTHON=C:\Path\To\Python311\python.exe

# Optional: Custom directory for SQLite database and FAISS index persistence
# Defaults to project-relative 'data_storage' directory
# SEEKVAULT_DATA_DIR=C:\Users\username\AppData\Local\SeekVault\data_storage

# Local-first enforcement: Prevents HuggingFace/Transformers from contacting remote endpoints
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Application Server Configuration
SEEKVAULT_HOST=localhost
SEEKVAULT_PORT=8501
